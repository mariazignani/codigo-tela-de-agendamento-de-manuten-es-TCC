private void RegistrarHistorico(DateTimeOffset dataPrevista, string motor, string descricao, int urgencia)
{
    @Tag.hist_dataPrevista = dataPrevista.DateTime.ToString("yyyy-MM-dd");
    @Tag.hist_dataConclusao = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
    @Tag.histMotor = motor ?? "";
    @Tag.hist_descricao = (descricao ?? "").Replace("'", " ");
    @Tag.hist_urgencia = urgencia;

    @Dataset.Query.InsereHistorico.ExecuteCommand();
}

private bool Atrasada(bool ocupada, bool naoConcluida, DateTimeOffset dataPrevista)
{
    if (!ocupada) { return false; }
    if (!naoConcluida) { return false; }

    return dataPrevista.DateTime.Date < DateTime.Today;
}
